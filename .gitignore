*.tsbuildinfo
next-env.d.ts

# .env.example يُحفَظ في المستودع كنموذج بلا أسرار
!.env.example

# ملف مراجعة مولَّد للعرض في المحرر، لا يُحفظ في المستودع
/REVIEW-changes.diff

# سجلات التشغيل المحلية (START-*.bat)
logs/
